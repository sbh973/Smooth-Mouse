{
  "manifest_version": 3,
  "name": "Smooth Mouse",
  "version": "0.1.0",
  "description": "Helps people with hand tremors use the web: adaptive cursor stabilization, click and key protection.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*"],
  "action": {
    "default_title": "Smooth Mouse",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/capture.js", "content/main.js"],
      "css": ["content/smooth-mouse.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "smooth-mouse@emoryhacks.local",
      "strict_min_version": "121.0"
    }
  }
}
