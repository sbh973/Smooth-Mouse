# Copy this file to .env (which git ignores) and fill in your real values.
# NEVER put a real key in this file: it is committed to GitHub.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Fast Gemini models (checked in Google's docs, Nov 2026: https://ai.google.dev/gemini-api/docs/models).
# gemini-3.6-flash answered in ~1 s in our tests; gemini-3.8-flash was overloaded (503s).
# The fallback is tried automatically if the main model is busy or fails.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
